# Browser-safe frontend API origin. Keep blank for the Vite proxy or same-origin FastAPI serving.
VITE_API_URL=
# Optional development proxy destination; default is http://127.0.0.1:8000
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Server-side only. Empty uses SQLite at backend/data/forgeiq.db.
# Production: use a persistent managed PostgreSQL connection string; never expose it as VITE_*.
# External MySQL/PostgreSQL connections enforce verified TLS; PostgreSQL private CAs use sslrootcert.
DATABASE_URL=
# Exact origins, comma-separated. Set production values to the deployed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
